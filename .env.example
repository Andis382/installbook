APP_NAME=InstallBook
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# The interface and the default customer language. Ships with sq and en.
APP_LOCALE=sq
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Europe/Tirane

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite needs no setup, but the pdo_sqlite extension must be present.
# For Postgres:  DB_CONNECTION=pgsql  DB_HOST=127.0.0.1  DB_PORT=5432
#                DB_DATABASE=installbook  DB_USERNAME=...  DB_PASSWORD=...
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=public

# ---------------------------------------------------------------------------
# Messaging
# ---------------------------------------------------------------------------
# manual    : the default. The app writes each message and the installer taps it
#             open in his own WhatsApp, to his own customer, from his own number.
#             No Meta account, no template approval, no per-message fee.
# log       : write to the log and mark as sent. For tests and demos.
# cloud_api : the server sends through the WhatsApp Cloud API. Needs a Meta
#             Business account, a verified number, and templates approved in
#             advance for anything outside a 24-hour customer service window.
INSTALLBOOK_MESSAGING_DRIVER=manual

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Names of your approved templates. Each takes the whole composed message as its
# single body parameter, so the wording stays in this app's language files.
WHATSAPP_TEMPLATE_CARD=
WHATSAPP_TEMPLATE_SERVICE_DUE=
WHATSAPP_TEMPLATE_WARRANTY_ENDING=
WHATSAPP_TEMPLATE_BOOKING_ACK=

# ---------------------------------------------------------------------------
# Reading the data plate (optional)
# ---------------------------------------------------------------------------
# none      : the default. The installer types brand, model and serial.
# anthropic : a vision model reads the photographed plate and pre-fills those
#             three fields for him to confirm. Needs ANTHROPIC_API_KEY.
INSTALLBOOK_OCR_DRIVER=none
ANTHROPIC_API_KEY=
INSTALLBOOK_OCR_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Defaults
# ---------------------------------------------------------------------------
INSTALLBOOK_COUNTRY_PREFIX=355
INSTALLBOOK_DEFAULT_LOCALE=sq
INSTALLBOOK_DEFAULT_TIMEZONE=Europe/Tirane
INSTALLBOOK_CURRENCY=EUR
# The guarantee a buyer has by law, in months. 24 across the EU. Never used as
# leverage in a message; shown on the card so it is not confused with the
# manufacturer's own warranty. Set to 0 where no statutory guarantee applies.
INSTALLBOOK_STATUTORY_MONTHS=24
INSTALLBOOK_MAX_UPLOAD_KB=8192
